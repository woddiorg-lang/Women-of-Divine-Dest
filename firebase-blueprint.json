{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile and progress",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "tutor", "admin"] },
        "pathway": { "type": "string", "enum": ["GMN", "NNN", "None"] },
        "country": { "type": "string" },
        "streak": { "type": "number" },
        "points": { "type": "number" },
        "createdAt": { "type": "number" },
        "completedRootingModules": { "type": "array", "items": { "type": "string" } },
        "completedBlueprintLessons": { "type": "array", "items": { "type": "string" } },
        "completedSkills": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["email", "name", "role", "country", "streak", "points", "createdAt"]
    },
    "post": {
      "title": "Post",
      "description": "Community forum post",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatarLetter": { "type": "string" },
        "authorPathway": { "type": "string" },
        "content": { "type": "string" },
        "likes": { "type": "number" },
        "comments": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["authorId", "authorName", "authorAvatarLetter", "content", "likes", "comments", "createdAt"]
    },
    "ticket": {
      "title": "Support Ticket",
      "description": "Support tickets raised by users",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["In Progress", "Resolved"] },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "subject", "message", "status", "createdAt"]
    },
    "listing": {
      "title": "Marketplace Listing",
      "description": "Service offered by user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "sellerName": { "type": "string" },
        "price": { "type": "string" },
        "desc": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "title", "category", "sellerName", "price", "desc", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/user" },
      "description": "Store user profiles."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/post" },
      "description": "Store community posts."
    },
    "/tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/ticket" },
      "description": "Store support tickets."
    },
    "/listings/{listingId}": {
      "schema": { "$ref": "#/entities/listing" },
      "description": "Store marketplace listings."
    }
  }
}
